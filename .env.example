# Copy this file to ".env" and fill it in. Never share or upload .env.
ADMIN_EMAIL=yourname@gmail.com        # OTP / reset codes are sent HERE
SMTP_USER=yourname@gmail.com          # Gmail that sends the mail (can be the same)
SMTP_PASS=abcd efgh ijkl mnop         # Gmail APP PASSWORD (not your normal password)
ADMIN_USER=admin
# ADMIN_PASSWORD=                     # optional; if empty a strong one is generated on first run
# NODE_ENV=production                 # set on the live server (HTTPS)
# TRUST_PROXY=1                       # set only if behind Nginx/Cloudflare
PORT=3000
